---
import { MapPin, Camera } from "@lucide/astro";
import { navLinks } from "../constants/navLinks";
---

<footer class="bg-black px-6 pb-8 pt-16 text-white sm:px-8 lg:px-12">
  <div class="mx-auto max-w-7xl">
    <div
      class="grid gap-12 border-b border-white/20 pb-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-8"
    >
      <div class="lg:col-span-2">
        <p
          class="mb-4 text-xs font-medium uppercase tracking-[0.25em] text-gray-500"
        >
          RT 08 · RW 03
        </p>

        <h2 class="text-3xl font-bold leading-tight sm:text-4xl">
          Bersama membangun
          <br />
          lingkungan yang lebih baik.
        </h2>

        <p class="mt-5 max-w-lg text-sm leading-relaxed text-gray-400">
          Website resmi RT 08 RW 03 Desa Bojonggenteng sebagai media informasi,
          komunikasi, dan dokumentasi kegiatan warga.
        </p>
      </div>

      <div>
        <h3
          class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500"
        >
          Navigasi
        </h3>

        <ul class="space-y-3 text-sm">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex transition-colors hover:text-gray-400"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3
          class="mb-5 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500"
        >
          Hubungi
        </h3>

        <ul class="space-y-5 text-sm">
          <li class="flex items-start gap-3">
            <MapPin
              size={17}
              stroke-width={1.5}
              class="mt-0.5 shrink-0 text-gray-400"
            />

            <div>
              <p class="text-gray-300">Desa Bojonggenteng</p>

              <p class="mt-1 text-xs text-gray-500">RT 08 / RW 03</p>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <Camera
              size={17}
              absoluteStrokeWidth={true}
              stroke-width={1.5}
              class="mt-0.5 shrink-0 text-gray-400"
            />

            <div>
              <a
                href="https://www.instagram.com/rt08bojonggenteng"
                target="_blank"
              >
                <p class="text-gray-300">@rt08bojonggenteng</p>
                <p class="mt-1 text-xs text-gray-500">Ikuti kegiatan warga</p>
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div class="flex justify-center gap-4 pt-6 text-xs text-gray-500">
      <p>
        © {new Date().getFullYear()} RT 08 RW 03.
      </p>
    </div>
  </div>
</footer>
