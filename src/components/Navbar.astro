---
import { navLinks } from "../constants/navLinks";
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-50 px-6 py-2 md:py-3 text-white transition-all duration-300 sm:px-6 lg:px-10"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    <a
      href="#hero"
      class="group flex items-center gap-3"
      aria-label="RT08 BOGET"
    >
      <span class="text-sm font-bold tracking-wide sm:block">RT08 BOGET</span>
    </a>

    <nav class="hidden md:block" aria-label="Navigasi utama">
      <ul class="flex items-center gap-1">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="group relative block px-3 py-2 text-sm font-medium"
              >
                <span>{link.name}</span>

                <span class="absolute inset-x-3 bottom-0 h-px origin-left scale-x-0 bg-current transition-transform duration-300 group-hover:scale-x-100" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      id="menu-toggle"
      type="button"
      aria-label="Buka menu"
      aria-expanded="false"
      class="flex h-10 w-10 items-center justify-center rounded-md border border-white/30 md:hidden"
    >
      <svg
        id="menu-open-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="4" y1="6" x2="20" y2="6"></line>
        <line x1="4" y1="12" x2="20" y2="12"></line>
        <line x1="4" y1="18" x2="20" y2="18"></line>
      </svg>

      <svg
        id="menu-close-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="mx-auto hidden max-w-7xl overflow-hidden md:hidden"
  >
    <nav class="mt-4 border-t border-current/20 pt-3" aria-label="Menu mobile">
      <ul>
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex items-center justify-between border-b border-current/10 px-2 py-3.5 text-sm font-medium transition-colors hover:text-gray-400"
              >
                <span>{link.name}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const navbar = document.querySelector("#navbar");
  const menuToggle = document.querySelector("#menu-toggle");
  const mobileMenu = document.querySelector("#mobile-menu");
  const openIcon = document.querySelector("#menu-open-icon");
  const closeIcon = document.querySelector("#menu-close-icon");

  const updateNavbar = () => {
    const isScrolled = window.scrollY > 40;
    const isMenuOpen = !mobileMenu?.classList.contains("hidden");

    if (isScrolled || isMenuOpen) {
      navbar?.classList.add("bg-white", "text-gray-900", "shadow-sm", "py-1");

      navbar?.classList.remove("text-white");
    } else {
      navbar?.classList.remove(
        "bg-white",
        "text-gray-900",
        "shadow-sm",
        "py-1",
      );

      navbar?.classList.add("text-white");
    }
  };

  const toggleMenu = () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;

    menuToggle?.setAttribute("aria-expanded", String(isOpen));

    openIcon?.classList.toggle("hidden", isOpen);
    closeIcon?.classList.toggle("hidden", !isOpen);

    updateNavbar();
  };

  menuToggle?.addEventListener("click", toggleMenu);

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.add("hidden");

      menuToggle?.setAttribute("aria-expanded", "false");

      openIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");

      updateNavbar();
    });
  });

  window.addEventListener("scroll", updateNavbar);

  updateNavbar();
</script>
