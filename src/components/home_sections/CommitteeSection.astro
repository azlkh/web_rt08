---
import { UserRound, ArrowUpRight } from "@lucide/astro";

const committee: { role: string; name: string }[] = [
  {
    role: "Ketua RT",
    name: "Anton Setiawan",
  },
  {
    role: "Sekretaris",
    name: "Polan",
  },
  {
    role: "Bendahara",
    name: "Polan",
  },
];
---

<section
  id="pengurus"
  class="scroll-mt-24 px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid gap-8 border-b border-gray-200 pb-12 md:grid-cols-2 md:items-end"
    >
      <div>
        <p
          class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-gray-500"
        >
          Struktur Organisasi
        </p>

        <h2
          class="text-3xl font-bold leading-tight text-gray-900 sm:text-4xl lg:text-5xl"
        >
          Pengurus
          <br />
          RT 08 / RW 03
        </h2>
      </div>

      <div class="md:pb-1 md:pl-8">
        <p class="max-w-xl text-sm leading-relaxed text-gray-600 sm:text-base">
          Tim pengurus yang bertanggung jawab dalam mengelola kegiatan,
          pelayanan, dan menjaga lingkungan agar tetap nyaman dan harmonis bagi
          seluruh warga.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-3">
      {
        committee.map((item, index) => (
          <article
            class:list={[
              "group py-10",
              index !== 0 &&
                "border-t border-gray-200 md:border-l md:border-t-0 md:px-8",
              index === 0 && "md:pr-8",
              index === committee.length - 1 && "md:pl-8",
            ]}
          >
            <div class="flex items-start justify-between">
              <div class="flex h-16 w-16 items-center justify-center border border-gray-300">
                <UserRound
                  size={28}
                  stroke-width={1.25}
                  class="text-gray-500"
                />
              </div>

              <ArrowUpRight
                size={20}
                stroke-width={1.5}
                class="text-gray-400 transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
              />
            </div>

            <div class="mt-8">
              <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">
                {item.role}
              </p>

              <h3 class="text-xl font-semibold text-gray-900 sm:text-2xl">
                {item.name}
              </h3>
            </div>

            <div class="mt-6 h-px w-10 bg-gray-900 transition-all duration-300 group-hover:w-20" />
          </article>
        ))
      }
    </div>
  </div>
</section>
