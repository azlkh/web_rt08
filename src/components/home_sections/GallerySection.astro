---
import { Image } from "astro:assets";
import { ArrowUpRight, Images } from "@lucide/astro";

import gallery1 from "../../assets/images/mulud_2025/1757317495541.webp";
import gallery2 from "../../assets/images/hut_ri_2025/20250817_102205.webp";
import gallery3 from "../../assets/images/hut_ri_2025/20250817_131203.webp";
import gallery4 from "../../assets/images/mulud_2025/1757317493211.webp";
import gallery5 from "../../assets/images/hut_ri_2025/20250817_132304.webp";
import gallery6 from "../../assets/images/mulud_2025/1757317494782.webp";

const images = [
  {
    src: gallery1,
    alt: "Kegiatan Maulid Nabi warga RT 08",
  },
  {
    src: gallery2,
    alt: "Perayaan 17 Agustus warga RT 08",
  },
  {
    src: gallery3,
    alt: "Kegiatan lomba 17 Agustus",
  },
  {
    src: gallery4,
    alt: "Kegiatan warga RT 08",
  },
  {
    src: gallery5,
    alt: "Perayaan kemerdekaan bersama warga",
  },
  {
    src: gallery6,
    alt: "Kegiatan Maulid Nabi Muhammad SAW",
  },
];
---

<section
  id="galeri"
  class="scroll-mt-24 px-6 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid gap-8 border-b border-gray-200 pb-12 md:grid-cols-2 md:items-end"
    >
      <div>
        <p
          class="mb-4 text-xs font-semibold uppercase tracking-[0.25em] text-gray-500"
        >
          Dokumentasi
        </p>

        <h2
          class="text-3xl font-bold leading-tight text-gray-900 sm:text-4xl lg:text-5xl"
        >
          Galeri
          <br />
          Warga
        </h2>
      </div>

      <div class="md:pb-1 md:pl-8">
        <p class="max-w-xl text-sm leading-relaxed text-gray-600 sm:text-base">
          Kumpulan dokumentasi berbagai momen kebersamaan dan kegiatan warga RT
          08 RW 03 Desa Bojonggenteng.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-2 pt-10 sm:gap-3 md:grid-cols-3 md:pt-12">
      {
        images.map((image, index) => (
          <a
            href={image.src.src}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative aspect-square overflow-hidden bg-gray-100"
          >
            <Image
              src={image.src}
              alt={image.alt}
              class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />

            <div class="absolute inset-0 bg-black/0 transition-colors duration-300 group-hover:bg-black/30" />

            <div class="absolute inset-x-0 bottom-0 flex translate-y-full items-end justify-between bg-black/70 px-3 py-3 text-white transition-transform duration-300 group-hover:translate-y-0 sm:px-4 sm:py-4">
              <div class="flex min-w-0 items-center gap-2">
                <Images size={15} stroke-width={1.5} class="shrink-0" />

                <span class="truncate text-xs font-medium sm:text-sm">
                  Kegiatan Warga
                </span>
              </div>

              <ArrowUpRight size={17} stroke-width={1.5} class="shrink-0" />
            </div>

            <span class="absolute left-3 top-3 text-xs font-medium text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 sm:left-4 sm:top-4">
              0{index + 1}
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="mt-8 flex items-center justify-between border-t border-gray-200 pt-5"
    >
      <p class="text-xs text-gray-500">
        {images.length} dokumentasi
      </p>

      <a
        href="/gallery"
        class="group inline-flex items-center gap-2 text-xs font-semibold text-gray-900 transition-colors hover:text-gray-500 sm:text-sm"
      >
        Lihat semua

        <ArrowUpRight
          size={16}
          stroke-width={1.5}
          class="transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1"
        />
      </a>
    </div>
  </div>
</section>
